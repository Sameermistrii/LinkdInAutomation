# Sign in with Google — authorized redirect:
# http://localhost:3000/api/auth/google/callback
# https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# LinkedIn posting — authorized redirect:
# http://localhost:3000/api/auth/linkedin/callback
# https://YOUR_DOMAIN/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
LINKEDIN_API_VERSION=202608

# Postgres — local Docker or Neon. Example Neon:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkedin_queue"

SESSION_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-another-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Vercel Blob for images when hosted (leave empty for local disk uploads/)
BLOB_READ_WRITE_TOKEN=
